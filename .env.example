# String de conexão do Postgres.
# Local (Homebrew ou docker-compose): postgresql://postgres:root@127.0.0.1:5432/financias_local
# Nuvem (Neon): o SSL é ligado automaticamente quando o host não é local.
DATABASE_URL=

# Segredo usado para assinar o JWT. Gere um valor longo e aleatório em produção.
JWT_SECRET=

# Porta da API. O frontend usa 3001 por padrão.
PORT=3001

# Chave do Google AI Studio (https://aistudio.google.com/apikey).
# Fica SÓ aqui: o frontend nunca a recebe, todas as chamadas ao Gemini saem do
# backend. Sem ela a API sobe normalmente e apenas o assistente fica indisponível.
GEMINI_API_KEY=

# Opcionais — os padrões são gemini-2.5-flash e 0.2.
# A temperatura é baixa de propósito: menos alucinação numérica e mais aderência
# às regras de escopo do assistente.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.2

# Teto de tokens da resposta. Por padrão NÃO é enviado: vale o máximo do próprio
# modelo. E se mesmo assim a resposta bater no teto, o backend pede a continuação
# e emenda sozinho — só defina isto para conter custo, nunca para "caber".
# GEMINI_MAX_OUTPUT_TOKENS=

# Limita quanto o modelo pode "pensar" antes de escrever (0 desliga o raciocínio,
# -1 deixa automático). Sem a variável vale o padrão do próprio modelo. Só mexa
# se as respostas estiverem lentas ou batendo no teto acima.
# GEMINI_THINKING_BUDGET=
